{
    "compilerOptions": {

        "target": "ES2017",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "incremental": true
    },
    "include": ["src/**/*", "src/types/**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
